    <string name="about_name_title">The name Ride-a-dent</string>
    <string name="about_name_text">Ride-a-dent is a playful combination of “Ride” and “Assistant”. The hyphenated form also shows how the app name Rideadent is meant to be pronounced.</string>
    <string name="about_features_title">What does the app do?</string>
    <string name="about_features_text">With a selected Bluetooth device connected, Rideadent can start and monitor Blitzer.de. It can also reject incoming calls and optionally send an automatic SMS. Both automations can be configured independently.</string>
    <string name="about_privacy_title">Privacy and important information</string>
    <string name="about_notice">Suitable Android permissions and battery settings are needed for background operation. Always follow traffic rules while travelling.</string>
